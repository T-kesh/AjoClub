{
  "name": "ajo-agent",
  "version": "1.0.0",
  "description": "AI-Agent-orchestrated Rotating Savings Clubs (Ajo/Chama) on Base",
  "private": true,
  "type": "module",
  "scripts": {
    "agent": "tsx agent/loop.ts",
    "bot": "tsx bot/index.ts",
    "indexer": "tsx indexer/index.ts",
    "db:init": "tsx db/init.ts",
    "test:db": "tsx db/test.ts",
    "test:agent": "cross-env SIMULATE_CHAIN=true tsx agent/test.ts",
    "pretest:adversarial": "node -e \"const{rmSync,existsSync}=require('fs');const p='./db/ajo_test_adversarial.db';if(existsSync(p))rmSync(p);if(existsSync(p+'-wal'))rmSync(p+'-wal');if(existsSync(p+'-shm'))rmSync(p+'-shm');\"",
    "test:adversarial": "cross-env DATABASE_PATH=./db/ajo_test_adversarial.db tsx --test agent/test_adversarial.ts",
    "test:e2e": "tsx agent/test_e2e.ts",
    "test:invariant": "npm --prefix contracts run test:invariant",
    "test:invariant:ci": "npm --prefix contracts run test:invariant:ci",
    "compile:contracts": "npm --prefix contracts run compile",
    "test:contracts": "npm --prefix contracts run test",
    "build": "npm --prefix web run build",
    "start": "npm --prefix web run start",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:lint": "npm --prefix web run lint"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "grammy": "^1.34.0",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "cross-env": "^10.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
