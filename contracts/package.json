{
  "name": "@ajo-club/contracts",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:invariant": "forge test --config-path foundry.toml -v",
    "test:invariant:ci": "forge test --config-path foundry.toml --profile ci -v",
    "deploy:base-sepolia": "hardhat ignition deploy ignition/modules/AjoClub.ts --network base-sepolia",
    "deploy:base": "hardhat ignition deploy ignition/modules/AjoClub.ts --network base",
    "verify:base-sepolia": "hardhat verify --network base-sepolia",
    "verify:base": "hardhat verify --network base"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^0.15.0",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0",
    "@selfxyz/contracts": "^1.2.3",
    "dotenv": "^16.6.1"
  }
}
