{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "agent/**/*",
    "bot/**/*",
    "indexer/**/*",
    "db/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "contracts",
    "web"
  ]
}
